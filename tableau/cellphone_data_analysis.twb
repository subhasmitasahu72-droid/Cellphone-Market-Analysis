        <zone h='41406' id='42' type-v2='text' w='22621' x='64788' y='10026'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='14'>Business Insights:</run>
            <run>&#10;•</run>
            <run fontsize='10'>Æ </run>
            <run bold='true' fontsize='10'>Market is concentrated, with few brands dominating model availability.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>• </run>
            <run bold='true' fontcolor='#e15759' fontsize='10'>Samsung</run>
            <run bold='true' fontsize='10'> and </run>
            <run bold='true' fontcolor='#e15759' fontsize='10'>Xiaomi</run>
            <run bold='true' fontsize='10'> lead in volume, while </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Apple</run>
            <run bold='true' fontsize='10'> focuses on premium positioning.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>• </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>High-end</run>
            <run bold='true' fontsize='10'> phones are mainly driven by </run>
            <run bold='true' fontcolor='#4e79a7' fontsize='10'>Samsung</run>
            <run bold='true' fontsize='10'> and </run>
            <run bold='true' fontcolor='#f28e2b' fontsize='10'>Apple</run>
            <run bold='true' fontsize='10'>.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>• </run>
            <run bold='true' fontcolor='#b07aa1' fontsize='10'>Android</run>
            <run bold='true' fontsize='10'> dominates the market; </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>iOS</run>
            <run bold='true' fontsize='10'> remains exclusive to Apple.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>• </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Price outliers</run>
            <run bold='true' fontsize='10'> are linked to higher RAM configurations.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
