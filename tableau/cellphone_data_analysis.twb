        <zone forceUpdate='true' h='44401' id='17' type-v2='text' w='22035' x='77599' y='14323'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='14'>Business Insights</run>
            <run bold='true' fontsize='14'>:</run>
            <run>&#10;•</run>
            <run bold='true'>The cellphone market is </run>
            <run bold='true' fontcolor='#000000'>highly price-segmented</run>
            <run bold='true'>, dominated by budget and </run>
            <run bold='true' fontcolor='#e15759'>mid-range</run>
            <run bold='true'> models.</run>
            <run>Æ&#10;</run>
            <run bold='true'>• </run>
            <run bold='true' fontcolor='#000000'>Sony</run>
            <run bold='true'> leads in average price, reflecting a premium-focused product portfolio.</run>
            <run>Æ&#10;</run>
            <run bold='true'>• Brand positioning significantly influences pricing beyond individual specifications.</run>
            <run>Æ&#10;</run>
            <run bold='true'>• </run>
            <run bold='true' fontcolor='#000000'>RAM</run>
            <run bold='true'> shows a</run>
            <run bold='true' fontcolor='#59a14f'> strong positive relationship</run>
            <run bold='true'> with </run>
            <run bold='true' fontcolor='#000000'>price</run>
            <run bold='true'>, making it a key pricing driver.</run>
            <run>Æ&#10;</run>
            <run bold='true'>• </run>
            <run bold='true' fontcolor='#000000'>Camera</run>
            <run bold='true'> features </run>
            <run bold='true' fontcolor='#e15759'>moderately</run>
            <run bold='true'> affect price, while</run>
            <run bold='true' fontcolor='#000000'> battery capacity</run>
            <run bold='true'> has </run>
            <run bold='true' fontcolor='#499894'>minimal impact</run>
            <run bold='true'>.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
